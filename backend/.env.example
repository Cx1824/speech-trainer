# ===== 应用配置 =====
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ===== CORS（前端地址，多个用逗号分隔）=====
CORS_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ===== 数据存储 =====
DATABASE_URL=sqlite+aiosqlite:///./data/speech_trainer.db
UPLOAD_DIR=./uploads
REPORT_DIR=./output
# 生产测试包可填 ../frontend_dist，由后端直接托管前端；开发时留空。
FRONTEND_DIST_DIR=

# ===== AI API 配置（用户也可在前端设置页配置写入此处）=====
# LLM
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.7

# ASR
ASR_PROVIDER=sherpa_onnx
ASR_BASE_URL=
ASR_API_KEY=
ASR_API_SECRET=
ASR_MODEL=sherpa-onnx-streaming-zipformer-zh-int8-2025-06-30

# TTS
TTS_PROVIDER=custom
TTS_BASE_URL=
TTS_API_KEY=
TTS_API_SECRET=
TTS_VOICE=
TTS_SPEED=1.0
